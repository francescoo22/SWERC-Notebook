// assign each job to a worker, #jobs must be <= #workers, all jobs must be assigned
// cost[i][j] is cost of job i done by worker j 
// NOTE: indices are ONE based, index 0 is used to insicate no assignment 
// Default finds min cost; to find max cost set all costs[i][j] to -costs[i][j]
static long hungarianMatch(vector<vector<int>>& a, vector<int>& ans) {
	ll INF = 1000000000000000L;
	int n = a.size()-1; // n of jobs
	int m = a[0].size()-1; // n of workers
	vector<ll> u(n+1), v(m+1);
	vector<int> way(m+1), p(m+1);
	for(int i=1; i<=n; i++){
		p[0] = i;
		int j0 = 0;
		vector<ll> minv(m+1, INF);
		vector<bool> used(m+1);
		do{
			used[j0] = true;
			int i0 = p[j0], j1 = -1;
			ll delta = INF;
			for(int j=1; j<=m; j++){
				if(!used[j]){
					ll cur = a[i0][j] - u[i0] - v[j];
					if(cur < minv[j]){
						minv[j] = cur; way[j] = j0;
					}
					if(minv[j] < delta){
						delta = minv[j]; j1 = j;
					}
				}
			}
			for(int j = 0; j <= m; ++j){
				if(used[j]){
					u[p[j]] += delta; v[j] -= delta;
				}
				else
					minv[j] -= delta;
			}
			j0 = j1;
		} while(p[j0] != 0);
		do{
			int j1 = way[j0];
			p[j0] = p[j1];
			j0 = j1;
		} while(j0 != 0);
	}
	for(int j = 1; j <= m ; j++){
		ans[p[j]] = j; // Assign job j to worker p[j]
	}

	return -v[0];
}