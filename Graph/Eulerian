vector<int> adj[maxn];
int deg[maxn];
vector<int> path;

void find_eulerian(int u){
    while(adj[u].size()){
        int v = adj[u].back();
        adj[u].pop_back();
        find_eulerian(v);
    }
    path.push_back(u);
}

int n, m;
int main(){
    cin >> n >> m;
    for(int i=0; i<m; i++){
        int u, v; cin >> u >> v;
        adj[u].push_back(v); 
        deg[u]++; deg[v]--;
    }
    int nst = 0, nend = 0, ust = 0, uend = 0;
    for(int i=0; i<n; i++){
        if(deg[i] > 1 || deg[i] < -1){
            nst = 3;
            break;
        }
        if(deg[i] == 1){
            nst++; ust = i;
        }
        if(deg[i] == -1){
            nend++; uend = i;
        }
    }
    if(nst > 1 || nend > 1 || (nst + nend == 1)){
        cout << "Impossible" << endl;
        return 0;
    }
    find_eulerian(ust);
    reverse(path.begin(), path.end());
    if(path.size() != m+1){
        cout << "Impossible" << endl;
        continue;
    }
    for(int i=0; i<path.size(); i++){
        cout << path[i] << " ";
    }
    cout << endl;
}

