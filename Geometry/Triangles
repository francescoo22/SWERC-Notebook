//ORTOCENTRO
/* Prerequisiti:
 * triarea()
 * closestpt()
 * intersection()
 */
int hcenter( pt p1, pt p2, pt p3, pt& r ){
	// point generated by altitudes
    // returns -1 if the triangle is degenerate
	if( triarea( p1, p2, p3 ) < EPS ) return -1;
	pt a1, a2;
	closestpt( p2, p3, p1, a1 );
	closestpt( p1, p3, p2, a2 );
	intersection( p1, a1, p2, a2, r );
	return 0;
}

//CIRCOCENTRO
/* Prerequisiti:
 * operatori: +, *, -
 * triarea()
 * intersection()
 */
int center( pt p1, pt p2, pt p3, pt& r ){
	// point generated by circumscribed circle
    // returns -1 if the triangle is degenerate
	if( triarea( p1, p2, p3 ) < EPS ) return -1;
	pt a1, a2, b1, b2;
	a1 = (p2+p3)*0.5;
	a2 = (p1+p3)*0.5;
	b1.x = a1.x - (p3.y-p2.y);
	b1.y = a1.y + (p3.x-p2.x);
	b2.x = a2.x - (p3.y-p1.y);
	b2.y = a2.y + (p3.x-p1.x);
	intersection( a1, b1, a2, b2, r );
	return 0;
}

/* INCENTRO
 * Prerequisiti:
 * operatori: +, *, /
 * dist()
 * triarea()
 * intersection()
 */
int icenter( pt p1, pt p2, pt p3, pt& r ){
	// angle bisection
    // returns -1 if the triangle is degenerate
	if( triarea( p1, p2, p3 ) < EPS ) return -1;
	dbl s1, s2, s3;
	s1 = dist( p2, p3 );
	s2 = dist( p1, p3 );
	s3 = dist( p1, p2 );
	
	
	dbl rt = s2/(s2+s3);
	pt a1,a2;
	a1 = p2*rt+p3*(1.0-rt);
	rt = s1/(s1+s3);
	a2 = p1*rt+p3*(1.0-rt);
	intersection( a1,p1, a2,p2, r );
	return 0;
}

//BARICENTRO
/* Prerequisiti:
 * operatori: +, /
 */
int bcenter(pt p1, pt p2, pt p3, pt& r){
    return (p1+p2+p3)/3.0;
}

//ALTEZZA RELATIVA A UN PUNTO
/* Prerequisiti
 * dist()
 * triarea()
 */
dbl height(pt a, pt b, pt c){
	// height from $a$ to the line $b\rightarrow c$
	dbl s3 = dist(c, b);
	dbl ar=triarea(a,b,c);
	return(2.0*ar/s3);
}