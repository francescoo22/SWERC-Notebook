class LinearSolver{
    public static double[][] solve(double coeff[][], double constants[][]){
		double inverted_mat[][] = invert(coeff);
		double result[][] = new double[constants.length][1];
		for (int i = 0; i < n; i++)
			for (int j = 0; j < 1; j++) 
				for (int k = 0; k < n; k++)
					result[i][j] = result[i][j] + inverted_mat[i][k] * constants[k][j];
        return result;
    }
	public static double[][] invert(double a[][]) {
        int n = a.length;
        double x[][] = new double[n][n];
        double b[][] = new double[n][n];
        int index[] = new int[n];
        for (int i=0; i<n; ++i) b[i][i] = 1;
        gauss(a, index);// Transform the matrix into an upper triangle
        for (int i=0; i<n-1; ++i)// Update the matrix b[i][j] with the ratios stored
            for (int j=i+1; j<n; ++j)
                for (int k=0; k<n; ++k)
                    b[index[j]][k]-= a[index[j]][i]*b[index[i]][k];
        for (int i=0; i<n; ++i){ // Perform backward substitutions
            x[n-1][i] = b[index[n-1]][i]/a[index[n-1]][n-1];
            for (int j=n-2; j>=0; --j) {
                x[j][i] = b[index[j]][i];
                for (int k=j+1; k<n; ++k) 
                    x[j][i] -= a[index[j]][k]*x[k][i];
                x[j][i] /= a[index[j]][j];
            }
        }
        return x;
    }
    public static void gauss(double a[][], int index[]){ // Method to carry out the Gaussian elimination
        int n = index.length;
        double c[] = new double[n];
        for (int i=0; i<n; ++i) // Initialize the index
            index[i] = i;
        for (int i=0; i<n; ++i){ // Find the rescaling factors, one from each row
            double c1 = 0;
            for (int j=0; j<n; ++j) {
                double c0 = Math.abs(a[i][j]);
                if (c0 > c1) c1 = c0;
            }
            c[i] = c1;
        }
        int k = 0;// Search the pivoting element from each column
        for (int j=0; j<n-1; ++j) {
            double pi1 = 0;
            for (int i=j; i<n; ++i) {
                double pi0 = Math.abs(a[index[i]][j]);
                pi0 /= c[index[i]];
                if (pi0 > pi1) {
                    pi1 = pi0;
                    k = i;
                }
            }
            int itmp = index[j];// Interchange rows according to the pivoting order
            index[j] = index[k];
            index[k] = itmp;
            for (int i=j+1; i<n; ++i) 	{
                double pj = a[index[i]][j]/a[index[j]][j];
                a[index[i]][j] = pj;// Record pivoting ratios below the diagonal
                for (int l=j+1; l<n; ++l)// Modify other elements accordingly
                    a[index[i]][l] -= pj*a[index[j]][l];
            }
        }
    }

// other method
    static double[] linearSolver(double[][] a) {
        int n = a.length;
        int m = a[0].length - 1;
        int[] where = new int[m];
        Arrays.fill(where, -1);     
        for (int col=0, row=0; col<m && row<n; ++col) {
            int sel = row;
            for (int i=row; i<n; ++i)
                if (Math.abs(a[i][col]) > Math.abs(a[sel][col]))
                    sel = i;
            if (Math.abs(a[sel][col]) < 10e-9)
                continue;
            for (int i=col; i<=m; ++i){
                double tmp = a[sel][i];
                a[sel][i] = a[row][i];
                a[row][i] = tmp;
            }
            where[col] = row;

            for (int i=0; i<n; ++i)
                if (i != row) {
                    double c = a[i][col] / a[row][col];
                    for (int j=col; j<=m; ++j)
                        a[i][j] -= a[row][j] * c;
                }
            ++row;
        }
        double[] ans = new double[m];
        for (int i=0; i<m; ++i)
            if (where[i] != -1)
                ans[i] = a[where[i]][m] / a[where[i]][i];
        for (int i=0; i<n; ++i) {
            double sum = 0;
            for (int j=0; j<m; ++j)
                sum += ans[j] * a[i][j];
            if (Math.abs(sum - a[i][m]) > 10e-9)
                return null; // no solution
        }

        for (int i=0; i<m; ++i)
            if (where[i] == -1)
                return new double[]{1.0/0.0}; // infinite solutions
        return ans; // one solution
    }
    
}